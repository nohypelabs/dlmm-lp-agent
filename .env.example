# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=your_helius_api_key_here
SOLANA_NETWORK=mainnet-beta

# Wallet Configuration
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Strategy Configuration
STARTING_CAPITAL=60
MAX_POSITIONS=1
TARGET_DAILY_GAIN=20
MAX_LOSS_PERCENT=10
MAX_IL_PERCENT=10
REBALANCE_FREQUENCY=6
PROFIT_TARGET_PERCENT=10
POSITION_TIMEOUT_HOURS=48
SLIPPAGE_BPS=300

# Token Filters
MIN_TOKEN_AGE_DAYS=1
MAX_TOKEN_AGE_DAYS=30
MIN_DAILY_VOLUME=50000
MAX_DAILY_VOLUME=50000000
MIN_LIQUIDITY=10000

# Meridian-inspired Filters (Optional - defaults used if not set)
MIN_FEE_ACTIVE_TVL_RATIO=0.05      # Minimum fee/TVL ratio (pool efficiency)
MIN_MCAP_USD=150000                # Minimum market cap $150k
MAX_MCAP_USD=10000000              # Maximum market cap $10M
MAX_TOP10_HOLDER_PCT=60            # Max 60% in top-10 holders
MAX_BUNDLERS_PCT=30                # Max 30% bundlers in top-100 holders
MAX_ATH_DISTANCE_PCT=50            # Reject if within 50% of ATH (pump-n-dump)
MIN_TOKEN_FEES_SOL=1               # Min 1 SOL in daily fees (active pool)
BLOCKED_LAUNCHPADS=                # Comma-separated blocked launchpad addresses

# DLMM Bin Step Configuration
MIN_BIN_STEP=80                    # Minimum bin step (narrower = better fees)
MAX_BIN_STEP=125                   # Maximum bin step (wider = more range)

# OKX OnchainOS Integration (Meridian-inspired)
OKX_ENABLED=false                  # Enable OKX risk checks
MAX_RISK_LEVEL=HIGH                # Max allowed risk level: LOW, MEDIUM, HIGH
MAX_BUNDLE_PCT=50                  # Max 50% bundler concentration
MAX_SNIPER_PCT=30                  # Max 30% sniper activity
MAX_SUSPICIOUS_PCT=20              # Max 20% suspicious wallets

# Operation Mode
MODE=full_auto  # Options: full_auto, manual_approve

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Safety
PAPER_TRADING=true  # Set to false for real trading
DRY_RUN=true
